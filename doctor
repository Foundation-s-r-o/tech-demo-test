#!/usr/bin/env bash
set -euo pipefail

export SEMGREP_SEND_METRICS=off

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "### Checking environment"
echo "- Bash version: $BASH_VERSION"
echo "- Node version: $(node --version 2>/dev/null || echo 'Node not found')"
echo "- npm version: $(npm --version 2>/dev/null || echo 'npm not found')"
echo "- Java version: $(java -version 2>&1 | head -n 1)"

echo
echo "### Running UI build & lint"
pushd "$script_dir/ui" >/dev/null
./scripts/build.sh
popd >/dev/null

echo
echo "### Running API build & tests"
pushd "$script_dir/api" >/dev/null
./mvnw clean verify
popd >/dev/null

echo
echo "### Running Playwright smoke tests (backend-free)"
pushd "$script_dir/ui" >/dev/null
npm run smoke
npm run smoke:storybook
popd >/dev/null

echo
echo "### Running Playwright E2E suite (starts API :8082 + UI :8080)"
for port in 8080 8082; do
  if lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
    echo "ERROR: port $port is already in use — stop the running server first."
    echo "       The E2E suite manages its own app servers (reuseExistingServer: false)."
    exit 1
  fi
done
pushd "$script_dir/ui" >/dev/null
npx playwright test
popd >/dev/null

echo
echo "### Checking OpenAPI client drift (spec -> generated TS client)"
pushd "$script_dir/ui" >/dev/null
tmp_gen="$(mktemp -d)"
npx openapi-generator-cli generate -i api-docs.json -g typescript-axios -o "$tmp_gen" \
  --additional-properties=useSingleRequestParameter=true,stringEnums=true,supportsES6=true >/dev/null
# .openapi-generator/ is bookkeeping metadata whose FILES list differs between
# fresh-dir and in-place generation; only the emitted client code matters.
if ! diff -r --exclude=.openapi-generator "$tmp_gen" src/api/generated; then
  echo "ERROR: src/api/generated is out of sync with api-docs.json —"
  echo "       run 'npm run generate-openapi-services' and commit the result."
  rm -rf "$tmp_gen"
  exit 1
fi
rm -rf "$tmp_gen"
popd >/dev/null

echo
echo "### Running local security scans"
"$script_dir/scripts/security_scan.sh"

echo
echo "### Running SonarQube analysis"
# Project-pinned host (see CLAUDE.md). Deliberately NOT read from $SONAR_HOST_URL —
# that env var carries a bare IP without scheme/port, which curl can't use.
sonar_host="http://10.16.35.113:9000"
sonar_issue_filter='
  def high_priority:
    (.severity == "BLOCKER" or .severity == "CRITICAL")
    or any(.impacts[]?; .severity == "BLOCKER" or .severity == "HIGH");
  def active:
    (.status // "OPEN") | IN("OPEN", "CONFIRMED", "REOPENED");
  def issue_summary:
    {
      key,
      rule,
      severity,
      impactSeverities: ([.impacts[]?.severity] | unique),
      type,
      component,
      line,
      message,
      effort,
      status
    };
  ([.issues[]? | select(high_priority and active) | issue_summary]) as $issues
  | {total: ($issues | length), issues: $issues}
'
if ! command -v sonar-scanner >/dev/null; then
  echo "WARNING: SKIPPED — sonar-scanner CLI not installed."
elif [[ -z "${SONAR_TOKEN:-}" ]]; then
  echo "WARNING: SKIPPED — SONAR_TOKEN is not set."
elif ! curl -sf --max-time 5 "$sonar_host/api/system/status" >/dev/null; then
  echo "WARNING: SKIPPED — SonarQube host $sonar_host is not reachable."
elif ! curl -sf --max-time 5 -u "$SONAR_TOKEN:" "$sonar_host/api/authentication/validate" | grep -q '"valid":true'; then
  echo "WARNING: SKIPPED — SONAR_TOKEN is not valid for $sonar_host (check you exported the token for THIS instance)."
else
  mkdir -p "$script_dir/docs"
  for module in api ui; do
    pushd "$script_dir/$module" >/dev/null
    sonar-scanner -Dsonar.host.url="$sonar_host" -Dsonar.token="$SONAR_TOKEN"
    popd >/dev/null
  done
  for key in tech-demo-api tech-demo-ui; do
    curl -s -u "$SONAR_TOKEN:" "$sonar_host/api/issues/search?componentKeys=$key&ps=500&resolved=false" \
      | jq "$sonar_issue_filter" > "$script_dir/docs/sonar-issues-$key.json"
    curl -s -u "$SONAR_TOKEN:" "$sonar_host/api/measures/component?component=$key&metricKeys=bugs,vulnerabilities,security_hotspots,code_smells,coverage" \
      | jq '.' > "$script_dir/docs/sonar-metrics-$key.json"
  done
fi

echo
echo "### Checking FOSSA CLI"
if ! command -v fossa >/dev/null; then
  echo "ERROR: FOSSA CLI not installed!"
  echo "Please install FOSSA CLI: https://docs.fossa.com/docs/cli/"
else
  fossa analyze
  # FOSSA is scan-only / non-blocking by decision (ADR-0008, SECURITY.md) — surface
  # policy issues loudly but do not fail the health check on them.
  if ! fossa test; then
    echo "WARNING: fossa test reported policy issues — review the FOSSA dashboard (non-blocking)."
  fi
fi

echo
echo "### Project health check completed successfully."
